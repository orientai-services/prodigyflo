# Copy to `.env` (gitignored). See HANDOFF.md.
# ─── Local ──────────────────────────────────────────────────
DATABASE_URL="postgresql://localhost:5432/prodigyflo"
APP_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"
AUTH_SECRET=""                  # openssl rand -base64 48
AI_PROVIDER="mock"
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_DIR="storage/documents"
SHOW_DEMO_ACCOUNTS="true"
DEMO_STAFF_PASSWORD=""          # required for npm run db:seed

# ─── Production (Vercel + Supabase) — comment local URLs above and use these
# DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require"
# APP_URL="https://prodigyflo.ai"
# AUTH_URL="https://prodigyflo.ai"
# NODE_ENV="production"
# FILE_STORAGE_DRIVER="s3"
# SHOW_DEMO_ACCOUNTS="false"
# PG_POOL_MAX=1

# ─── Auth (Auth.js v5) ──────────────────────────────────────
# AUTH_SECRET is set in the Local block above. Rotate independently of VAULT_KEY.

# ─── AI provider ────────────────────────────────────────────
# "mock" runs the deterministic analyzer; no key required.
AI_PROVIDER="mock"            # mock | anthropic
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ─── Analytics ──────────────────────────────────────────────
# Google Tag Manager container. Unset -> GTM never loads (dev/preview).
# Public by design; it ships in the page source.
NEXT_PUBLIC_GTM_ID=""         # e.g. GTM-KGTL4GDC

# ─── Connectors (all optional; unset -> mock adapter) ───────
CREDIT_BUREAU_API_KEY=""
CREDIT_BUREAU_BASE_URL=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@prodigyflo.ai"

CALENDAR_CLIENT_ID=""
CALENDAR_CLIENT_SECRET=""
CALENDAR_REDIRECT_URI=""

META_APP_ID=""
META_APP_SECRET=""
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=""

PAYMENT_PROVIDER_SECRET_KEY=""
PAYMENT_PROVIDER_PUBLIC_KEY=""

FINANCING_PROVIDER_API_KEY=""
FINANCING_PROVIDER_BASE_URL=""

CYS_SUBMISSION_URL=""
CYS_API_KEY=""

ATTORNEY_SUBMISSION_URL=""
ATTORNEY_API_KEY=""

FILE_STORAGE_ENDPOINT=""
FILE_STORAGE_REGION="us-east-1"
FILE_STORAGE_BUCKET="prodigyflo-documents"
FILE_STORAGE_ACCESS_KEY=""
FILE_STORAGE_SECRET_KEY=""
# FILE_STORAGE_FORCE_PATH_STYLE="true"   # auto-on for supabase hosts
# FILE_STORAGE_ACL=""                    # omit on Supabase Storage; "private" on Spaces/AWS

# ── Provider selection (all default to a labelled mock adapter) ──
EMAIL_PROVIDER="mock"
SMS_PROVIDER="mock"
SHEETS_PROVIDER="mock"
# FILE_STORAGE_DRIVER / FILE_STORAGE_LOCAL_DIR / SHOW_DEMO_ACCOUNTS / DEMO_STAFF_PASSWORD
# are set in the Local block at the top.
FILE_SIGNED_URL_TTL="300"

# Production document storage. Do not use local disk in production (Vercel has none).
# FILE_STORAGE_DRIVER="s3"
# Supabase Storage S3 API:
# FILE_STORAGE_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
# FILE_STORAGE_BUCKET="<bucket>"
# Spaces fallback still works:
# FILE_STORAGE_ENDPOINT="https://nyc3.digitaloceanspaces.com"
# FILE_STORAGE_BUCKET="prodigyflo-documents"

# Vercel Cron (`vercel.json` → GET /api/jobs/run every 5 min). Vercel sends
# Authorization: Bearer $CRON_SECRET. JOBS_TOKEN is also accepted (droplet timer
# and inbound HMAC still use JOBS_TOKEN).
CRON_SECRET=""
JOBS_TOKEN=""

# Cloudflare Email Routing (company aliases forwarding to personal inboxes)
CLOUDFLARE_EMAIL_TOKEN=""
CF_ACCOUNT_ID=""
CF_EMAIL_ZONE_ID=""
EMAIL_DOMAIN="prodigyflo.ai"

# ── Enhancement wave (2026-08-28) ────────────────────────────────
# Credential vault: AES-256-GCM key material for per-connector API keys.
# Deliberately separate from AUTH_SECRET so session-key rotation never
# bricks stored credentials. encryptSecret throws when unset.
VAULT_KEY=""

# Real email sending: set EMAIL_PROVIDER="resend" plus these (or store them
# in the email-service connector's credential vault in Settings → Connectors).
RESEND_API_KEY=""
EMAIL_FROM=""

# Real SMS sending: set SMS_PROVIDER="twilio" plus these (or use the
# twilio-sms connector's credential vault).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Meta Business API (ad account creation + system-user ads management).
# Page tokens usually cannot manage ads — set a system-user token.
META_BUSINESS_ID=""
META_SYSTEM_USER_TOKEN=""

# Deploy console (owner-only, step-up gated). Unset = labelled mock mode.
DEPLOY_SCRIPT=""
DEPLOY_LOG=""
DEPLOY_REPO_DIR=""

# ── Telephony: phone numbers, call routing, the prepaid wallet ───
# Carrier adapter. "mock" (default) mints practice numbers inside the reserved
# 555-01xx fiction block so the whole flow works before a Twilio account
# exists; "twilio" buys real ones.
TELEPHONY_PROVIDER=mock
# Numbers are bought with the account's own vault credentials when it has
# them (Settings -> Connectors -> Twilio SMS), otherwise these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Accounts billed to the agency card instead of a prepaid balance. Everyone
# else must fund a wallet before they can buy a number. An AGENCY-kind org is
# always internal regardless of this list.
TELEPHONY_INTERNAL_SLUGS=prodigyflo,cys,scs

# The agency provisioning passphrase, asked for before any number goes on the
# agency card. Store the bcrypt HASH, never the passphrase:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'the passphrase'
# WARNING: a bcrypt hash is full of $, and Next.js expands $NAME when it reads
# a .env file. In a .env, escape every dollar -> '\$2b\$10\$...' (single-quoted).
# A systemd EnvironmentFile (/etc/prodigyflo.env) does NOT expand: paste it raw.
# Unset -> internal accounts simply cannot buy numbers (closed by default).
TELEPHONY_AGENCY_PASSPHRASE_HASH=

# Local development ONLY. Skips the X-Twilio-Signature check on the carrier
# webhooks, which is the only authentication those public endpoints have.
# Never set this in production.
TELEPHONY_ALLOW_UNSIGNED_WEBHOOKS=
