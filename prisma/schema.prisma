// ProdigyFlo — Sales Client Overview
// Prisma schema. Every tenant-scoped model carries organizationId for isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum RoleKey {
  SUPER_ADMIN
  ADMIN
  REGIONAL_MANAGER
  SALES_MANAGER
  CLOSER
  DOCUMENT_COLLECTOR
  MARKETING
  CLIENT
}

enum StageKey {
  NEW_LEAD
  SURVEY_STARTED
  SURVEY_COMPLETED
  INFO_VERIFICATION
  CONSENT_PENDING
  CREDIT_PULL_PENDING
  CREDIT_PULL_COMPLETED
  QUALIFICATION_REVIEW
  QUALIFIED
  NOT_QUALIFIED
  APPOINTMENT_SCHEDULING
  APPOINTMENT_SCHEDULED
  PRESENTATION_COMPLETED
  FOLLOW_UP
  PAYMENT_SELECTION
  DOCUMENT_COLLECTION
  COMMUNICATION_EVIDENCE_REVIEW
  ATTORNEY_DOCUMENT_REVIEW
  DEAL_READY_FOR_SUBMISSION
  SUBMITTED
  CORRECTIONS_REQUESTED
  APPROVED
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
}

enum StageCategory {
  INTAKE
  QUALIFICATION
  SALES
  FULFILLMENT
  SUBMISSION
  TERMINAL
}

enum ClientStatus {
  ACTIVE
  ON_HOLD
  DISQUALIFIED
  CLOSED_WON
  CLOSED_LOST
}

enum SurveyStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ConsentType {
  SOFT_CREDIT_PULL
  ELECTRONIC_COMMUNICATION
  TCPA_CONTACT
  PRIVACY_POLICY
  ESIGN_DISCLOSURE
  DOCUMENT_RELEASE
}

enum VerificationType {
  EMAIL
  PHONE
  IDENTITY
  ADDRESS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum CreditPullStatus {
  NOT_REQUESTED
  CONSENT_REQUIRED
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum QualificationOutcome {
  QUALIFIED
  NOT_QUALIFIED
  NEEDS_MORE_INFO
  PENDING
}

enum AppointmentType {
  DISCOVERY
  PRESENTATION
  FOLLOW_UP
  DOCUMENT_REVIEW
  CLOSING
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

enum PaymentPath {
  CASH
  CARD
  ACH
  FINANCING
  UNDECIDED
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  DEPOSIT_PAID
  PAID_IN_FULL
  FAILED
  REFUNDED
}

enum FinancingStatus {
  NOT_SUBMITTED
  SUBMITTED
  PENDING
  APPROVED
  DECLINED
  ADDITIONAL_INFO_REQUIRED
  EXPIRED
}

enum DocumentStatus {
  REQUESTED
  RECEIVED
  PROCESSING
  UNDER_REVIEW
  MISSING_INFORMATION
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentCategory {
  COMMUNICATION_EVIDENCE
  ATTORNEY_REQUIRED
  CONTRACT
  IDENTITY
  INCOME
  OTHER
}

enum CommunicationChannel {
  CALL
  SMS
  IMESSAGE
  EMAIL
  PORTAL_MESSAGE
  MESSENGER
  IN_PERSON
  NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum CallOutcome {
  CONNECTED
  VOICEMAIL
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  DECLINED
  FAILED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubmissionDestination {
  CYS
  ATTORNEY
}

enum SubmissionStatus {
  DRAFT
  READY
  SUBMITTED
  ACKNOWLEDGED
  CORRECTIONS_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
}

/// Lifecycle of a document copied from an authenticated external intake.
/// PENDING/FAILED rows are deliberately durable so the job runner can retry
/// without asking the homeowner to upload again. ARCHIVED retains historical
/// provenance but is terminal and is never selected by the import worker.
enum ExternalDocumentImportStatus {
  PENDING
  IMPORTING
  IMPORTED
  FAILED
  ARCHIVED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum AIRecommendationType {
  ONBOARDING_ANALYSIS
  QUALIFICATION
  CLOSER_ASSIGNMENT
  NEXT_BEST_ACTION
  FOLLOW_UP_DRAFT
}

enum AIRecommendationStatus {
  PENDING_REVIEW
  ACCEPTED
  OVERRIDDEN
  DISMISSED
}

enum ConnectorKind {
  CREDIT_BUREAU
  TWILIO_VOICE
  TWILIO_SMS
  IMESSAGE
  EMAIL
  CALENDAR
  META_ADS
  PAYMENT
  FINANCING
  CYS
  ATTORNEY
  FILE_STORAGE
  AI_PROVIDER
  GO_HIGH_LEVEL
}

enum ConnectorStatus {
  NOT_CONFIGURED
  MOCK
  CONNECTED
  ERROR
  DISABLED
}

enum AttributionTouch {
  FIRST
  LAST
  MIDDLE
}

enum NotificationKind {
  ASSIGNMENT
  APPOINTMENT
  DOCUMENT
  SUBMISSION
  SLA_WARNING
  MESSAGE
  SYSTEM
}

// ─────────────────────────────────────────────────────────────
// Organization hierarchy & access control
// ─────────────────────────────────────────────────────────────

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  /// AGENCY (the master account whose users may switch into child accounts)
  /// or CLIENT (a customer account, optionally parented to an agency).
  kind                 String    @default("CLIENT")
  /// Self-relation: a CLIENT account owned by an AGENCY points at it here.
  parentOrganizationId String?
  timezone             String    @default("America/Los_Angeles")
  settings             Json      @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  parentOrganization Organization?  @relation("OrgTree", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations Organization[] @relation("OrgTree")

  regions          Region[]
  teams            Team[]
  users            User[]
  roles            Role[]
  clients          Client[]
  pipelines        Pipeline[]
  campaigns        Campaign[]
  leadSources      LeadSource[]
  connectors       Connector[]
  auditEvents      AuditEvent[]
  documentPackages DocumentPackage[]
  closerBriefs     CloserBrief[]
  coachingNotes    CoachingNote[]
  nurtureTouches   NurtureTouch[]
  hotLeadReviews   HotLeadReview[]
  inboundEvents    InboundEvent[]
  inboundDocuments InboundDocument[]
  surveys          Survey[]
  notifications    Notification[]

  intakeSources        IntakeSource[]
  intakeSubmissions    IntakeSubmission[]
  externalDocumentImports ExternalDocumentImport[]
  invites              Invite[]
  sequences            Sequence[]
  scheduledMessages    ScheduledMessage[]
  savedFilters         SavedFilter[]
  messageTemplates     MessageTemplate[]
  cysFieldDefinitions  CysFieldDefinition[]
  connectorCredentials ConnectorCredential[]
  adSets               AdSet[]
  engineRuns           EngineRun[]
  insights             Insight[]
  deployRuns           DeployRun[]
  phoneNumbers         PhoneNumber[]
  telephonyWallet      TelephonyWallet?
  walletEntries        WalletEntry[]

  @@index([parentOrganizationId])
}

model Region {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  timezone       String    @default("America/Los_Angeles")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  users        User[]
  clients      Client[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  regionId       String?
  name           String
  managerId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region       Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  manager      User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      User[]       @relation("TeamMembers")
  clients      Client[]
  defaultIntakeSources IntakeSource[] @relation("IntakeDefaultTeam")

  @@index([organizationId])
  @@index([regionId])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String
  category    String

  roles RolePermission[]
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            RoleKey
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        User[]
  invites      Invite[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String  @id @default(cuid())
  organizationId String
  roleId         String
  regionId       String?
  teamId         String?
  managerId      String?

  email        String
  passwordHash String
  name         String
  /// The organization's true owner. Deliberately invisible in the UI — the role
  /// label stays "Super Admin" so the owner reads as a peer. Grants: sole right
  /// to mint Super Admins, unmanageable by anyone else.
  isOwner      Boolean @default(false)
  nickname     String?
  /// Optional post-login landing route override (e.g. a demo user pinned to /recovery).
  landingPath  String?
  phone        String?
  avatarUrl    String?
  title        String?

  // Email identity: a company address (alias@<domain>) that forwards to the
  // user's own inbox via Cloudflare Email Routing, plus signature preferences.
  emailAlias            String?
  forwardingEmail       String?
  forwardingStatus      String    @default("none") // none | pending | active
  signatureStyle        String    @default("formal") // formal | friendly
  signatureIncludePhone Boolean   @default(true)
  languages             String[]  @default([])
  licensedIn            String[]  @default([])
  specialties           String[]  @default([])
  isActive              Boolean   @default(true)
  maxWorkload           Int       @default(40)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  region       Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  manager      User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]       @relation("UserManager")

  managedTeams         Team[]                @relation("TeamManager")
  clientPortalLink     Client?               @relation("ClientUser")
  ownedClients         Client[]              @relation("ClientOwner")
  assignments          Assignment[]          @relation("AssignmentAssignee")
  assignmentsMade      Assignment[]          @relation("AssignmentAssigner")
  appointments         Appointment[]         @relation("AppointmentOwner")
  availability         AvailabilitySlot[]
  presentations        Presentation[]
  qualificationReviews QualificationReview[]
  documentReviews      DocumentReview[]
  communications       Communication[]
  tasksAssigned        Task[]                @relation("TaskAssignee")
  tasksCreated         Task[]                @relation("TaskCreator")
  notes                Note[]
  stageChanges         StageHistory[]
  submissions          Submission[]
  aiOverrides          AIRecommendation[]    @relation("AIReviewer")
  auditEvents          AuditEvent[]
  notifications        Notification[]
  sessions             UserSession[]
  collectorDocuments   ClientDocument[]      @relation("DocumentCollector")

  verifiedFields        ExtractedField[]      @relation("FieldVerifier")
  sentInvites           Invite[]              @relation("InviteSender")
  acceptedInvite        Invite?               @relation("InviteAccepted")
  sequencesCreated      Sequence[]            @relation("SequenceAuthor")
  scheduledMessages     ScheduledMessage[]    @relation("ScheduledSender")
  savedFilters          SavedFilter[]
  cysVerifications      CysFieldValue[]       @relation("CysVerifier")
  closerBriefsRequested CloserBrief[]         @relation("BriefRequester")
  closerBriefsViewed    CloserBrief[]         @relation("BriefViewer")
  coachingGiven         CoachingNote[]        @relation("CoachAuthor")
  coachingReceived      CoachingNote[]        @relation("CoachSubject")
  nurtureTouchesSent    NurtureTouch[]        @relation("NurtureSender")
  hotLeadReviews        HotLeadReview[]       @relation("HotLeadReviewer")
  cysApprovals          CysReadiness[]        @relation("CysApprover")
  messageTemplates      MessageTemplate[]     @relation("TemplateAuthor")
  intakeSourcesOwned    IntakeSource[]        @relation("IntakeDefaultOwner")
  credentialsCreated    ConnectorCredential[] @relation("CredentialCreator")
  insightsReviewed      Insight[]             @relation("InsightReviewer")
  deployRunsStarted     DeployRun[]           @relation("DeployStarter")
  authTokens            AuthToken[]
  phoneNumbersAssigned  PhoneNumber[]         @relation("PhoneNumberAssignee")
  phoneNumbersCreated   PhoneNumber[]         @relation("PhoneNumberCreator")
  walletEntriesCreated  WalletEntry[]         @relation("WalletEntryCreator")

  @@unique([organizationId, email])
  @@unique([organizationId, emailAlias])
  @@index([organizationId])
  @@index([teamId])
  @@index([regionId])
  @@index([managerId])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Short-lived, single-use tokens behind the self-service auth flows
/// (password reset + magic-link sign-in). Only the sha256 hash is stored;
/// the plaintext appears once, inside the emailed link. Deliberately org-less:
/// login is org-blind (email is globally unique by policy), so the token binds
/// to the user directly and cascades away with the account.
model AuthToken {
  id              String    @id @default(cuid())
  userId          String
  kind            String // PASSWORD_RESET | MAGIC_LINK
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  requestedIpHash String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Pipeline
// ─────────────────────────────────────────────────────────────

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  clients      Client[]

  @@index([organizationId])
}

model PipelineStage {
  id         String        @id @default(cuid())
  pipelineId String
  key        StageKey
  name       String
  category   StageCategory
  position   Int
  slaHours   Int?
  isTerminal Boolean       @default(false)

  requiredFields  String[]   @default([])
  checklist       Json       @default("[]")
  allowedNextKeys StageKey[] @default([])
  autoAdvance     Boolean    @default(false)
  description     String?

  pipeline     Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  clients      Client[]
  stageHistory StageHistory[]

  @@unique([pipelineId, key])
  @@index([pipelineId])
}

model StageHistory {
  id              String    @id @default(cuid())
  clientId        String
  stageId         String
  fromKey         StageKey?
  toKey           StageKey
  enteredAt       DateTime  @default(now())
  exitedAt        DateTime?
  durationMinutes Int?
  changedById     String?
  automated       Boolean   @default(false)
  reason          String?
  note            String?

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  changedBy User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([stageId])
}

// ─────────────────────────────────────────────────────────────
// Client
// ─────────────────────────────────────────────────────────────

model Client {
  id             String  @id @default(cuid())
  organizationId String
  pipelineId     String
  currentStageId String
  regionId       String?
  teamId         String?
  ownerId        String?
  portalUserId   String? @unique

  firstName         String
  lastName          String
  email             String
  phone             String
  preferredLanguage String       @default("en")
  preferredContact  String       @default("phone")
  // Instagram identity for leads from Instagram DMs/comments/story replies
  // (which carry a handle, not an email/phone). instagramUserId is the STABLE
  // Instagram-scoped sender id — the dedupe key that maps a repeat messager to
  // one client; instagramHandle is the best-effort display @username, backfilled
  // when a profile lookup succeeds. Both null for every other lead source.
  instagramUserId   String?
  instagramHandle   String?
  status            ClientStatus @default(ACTIVE)

  leadSourceId String?
  campaignId   String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?

  estimatedValue       Decimal?  @db.Decimal(12, 2)
  probability          Int?
  // AI probability-to-close (0-100). A prioritization signal, never a decision:
  // humans qualify; this only orders the call queue. See src/lib/closeops.ts.
  aiCloseProbability   Int?
  aiCloseProbabilityAt DateTime?
  expectedCloseAt      DateTime?
  lostReason           String?
  holdReason           String?
  disqualifiedReason   String?

  stageEnteredAt DateTime  @default(now())
  firstContactAt DateTime?
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id])
  currentStage PipelineStage @relation(fields: [currentStageId], references: [id])
  region       Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner        User?         @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  portalUser   User?         @relation("ClientUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  leadSource   LeadSource?   @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  addresses             ClientAddress[]
  surveyResponses       SurveyResponse[]
  consents              Consent[]
  verifications         Verification[]
  creditPulls           CreditPull[]
  qualificationReviews  QualificationReview[]
  contracts             Contract[]
  stageHistory          StageHistory[]
  assignments           Assignment[]
  appointments          Appointment[]
  presentations         Presentation[]
  paymentMethods        PaymentMethod[]
  financingApplications FinancingApplication[]
  documents             ClientDocument[]
  communications        Communication[]
  tasks                 Task[]
  notes                 Note[]
  attributionEvents     AttributionEvent[]
  deal                  Deal?
  submissions           Submission[]
  aiRecommendations     AIRecommendation[]
  intakeSubmissions     IntakeSubmission[]
  externalDocumentImports ExternalDocumentImport[]
  cysReadiness          CysReadiness?
  cysFieldValues        CysFieldValue[]
  sequenceEnrollments   SequenceEnrollment[]
  scheduledMessages     ScheduledMessage[]
  closerBriefs          CloserBrief[]
  coachingNotes         CoachingNote[]
  nurtureTouches        NurtureTouch[]
  hotLeadReviews        HotLeadReview[]
  inboundEvents         InboundEvent[]
  inboundDocuments      InboundDocument[]

  // One live client per Instagram sender per org (nulls stay distinct in
  // Postgres, so non-Instagram leads are unaffected). Enforces the dedupe.
  @@unique([organizationId, instagramUserId])
  @@index([organizationId])
  @@index([currentStageId])
  @@index([ownerId])
  @@index([teamId])
  @@index([regionId])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([leadSourceId])
  @@index([organizationId, aiCloseProbability])
}

model ClientAddress {
  id         String   @id @default(cuid())
  clientId   String
  label      String   @default("primary")
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Survey
// ─────────────────────────────────────────────────────────────

model Survey {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  schema         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses    SurveyResponse[]

  @@index([organizationId])
}

model SurveyResponse {
  id              String       @id @default(cuid())
  surveyId        String
  clientId        String
  status          SurveyStatus @default(IN_PROGRESS)
  currentStep     Int          @default(0)
  answers         Json         @default("{}")
  resumeTokenHash String?      @unique
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  abandonedAt     DateTime?
  updatedAt       DateTime     @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([surveyId])
}

// ─────────────────────────────────────────────────────────────
// Consent, verification, credit
// ─────────────────────────────────────────────────────────────

model Consent {
  id          String      @id @default(cuid())
  clientId    String
  type        ConsentType
  granted     Boolean
  textVersion String
  text        String
  purpose     String
  ipHash      String?
  userAgent   String?
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?
  expiresAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, type])
}

model Verification {
  id           String             @id @default(cuid())
  clientId     String
  type         VerificationType
  status       VerificationStatus @default(PENDING)
  value        String?
  maskedValue  String?
  method       String?
  verifiedAt   DateTime?
  verifiedById String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type])
  @@index([clientId])
}

model CreditPull {
  id                 String           @id @default(cuid())
  clientId           String
  consentId          String?
  provider           String           @default("mock")
  status             CreditPullStatus @default(NOT_REQUESTED)
  permissiblePurpose String?

  scoreBand          String?
  scoreRangeLow      Int?
  scoreRangeHigh     Int?
  tradelines         Int?
  derogatoryMarks    Int?
  utilizationPct     Int?
  monthlyObligations Decimal?  @db.Decimal(12, 2)
  externalRef        String?
  requestedAt        DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  failureReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model QualificationReview {
  id         String               @id @default(cuid())
  clientId   String
  outcome    QualificationOutcome @default(PENDING)
  reviewerId String?
  reviewedAt DateTime?

  aiRecommendedOutcome QualificationOutcome?
  aiConfidence         Int?
  aiReasons            Json                  @default("[]")
  missingEvidence      Json                  @default("[]")
  rulesEvaluated       Json                  @default("[]")
  overrideReason       String?
  decisionNotes        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
