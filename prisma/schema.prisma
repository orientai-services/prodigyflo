// ─────────────────────────────────────────────────────────────
// Document analysis (Phase 4)
// ─────────────────────────────────────────────────────────────

enum ExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FieldVerification {
  UNVERIFIED
  VERIFIED
  CORRECTED
  REJECTED
}

/// One AI pass over one document version. Never mutated after COMPLETED — a
/// re-run creates a new row so the review history stays intact.
model DocumentExtraction {
  id                String           @id @default(cuid())
  documentId        String
  status            ExtractionStatus @default(PENDING)
  provider          String           @default("mock")
  model             String?
  detectedTypeKey   String?
  detectedTypeLabel String?
  typeConfidence    Int?
  pageCount         Int?
  rawText           String?
  summary           String?
  warnings          Json             @default("[]")
  missingFieldKeys  String[]         @default([])
  error             String?
  promptTokens      Int?
  completionTokens  Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())

  document ClientDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fields   ExtractedField[]

  @@index([documentId])
  @@index([status])
}

/// A single AI-proposed value. `value` is what the model read; `correctedValue`
/// is what a human said it really is. Downstream code must read the corrected
/// value when present, and must treat UNVERIFIED as "not client data yet".
model ExtractedField {
  id              String            @id @default(cuid())
  extractionId    String
  key             String
  label           String
  value           String?
  normalizedValue String?
  confidence      Int               @default(0)
  sourcePage      Int?
  sourceSnippet   String?
  verification    FieldVerification @default(UNVERIFIED)
  correctedValue  String?
  conflictNote    String?
  reviewerNote    String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  extraction DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  verifiedBy User?              @relation("FieldVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  cysValues  CysFieldValue[]    @relation("CysSourceField")

  @@unique([extractionId, key])
  @@index([extractionId])
}

// ─────────────────────────────────────────────────────────────
// CYS readiness (Phase 5)
// ─────────────────────────────────────────────────────────────

enum CysSourceType {
  CLIENT_FIELD
  ADDRESS_FIELD
  DOCUMENT_FIELD
  SURVEY_FIELD
  MANUAL
}

enum CysValueStatus {
  MISSING
  SUGGESTED
  VERIFIED
  CONFLICT
}

/// The configurable CYS field map. No CYS API is assumed — this describes the
/// shape of the package we hand over, and is editable in Settings.
model CysFieldDefinition {
  id             String        @id @default(cuid())
  organizationId String
  key            String
  label          String
  groupName      String        @default("General")
  position       Int           @default(0)
  isRequired     Boolean       @default(true)
  dataType       String        @default("string")
  sourceType     CysSourceType @default(CLIENT_FIELD)
  /// Dot-path into the source, e.g. client.email or document.utility_bill.account_number.
  sourcePath     String?
  helpText       String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model CysReadiness {
  id                 String    @id @default(cuid())
  clientId           String    @unique
  completionPct      Int       @default(0)
  requiredTotal      Int       @default(0)
  requiredVerified   Int       @default(0)
  checklist          Json      @default("[]")
  packageJson        Json?
  packageGeneratedAt DateTime?
  approvedById       String?
  approvedAt         DateTime?
  approvalNote       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("CysApprover", fields: [approvedById], references: [id], onDelete: SetNull)
}

/// The resolved value for one CYS field on one client, plus where it came from.
model CysFieldValue {
  id                     String         @id @default(cuid())
  clientId               String
  fieldKey               String
  value                  String?
  status                 CysValueStatus @default(MISSING)
  confidence             Int?
  sourceLabel            String?
  sourceDocumentId       String?
  sourceExtractedFieldId String?
  conflictValue          String?
  note                   String?
  verifiedById           String?
  verifiedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceDocument ClientDocument? @relation("CysSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sourceField    ExtractedField? @relation("CysSourceField", fields: [sourceExtractedFieldId], references: [id], onDelete: SetNull)
  verifiedBy     User?           @relation("CysVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([clientId, fieldKey])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Staff invites
// ─────────────────────────────────────────────────────────────

/// A one-time, expiring invitation to join the organization's staff. Only the
/// SHA-256 of the link token is stored; the plaintext is shown once at creation
/// (and again on an explicit link reset, which rotates the token).
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  /// Null = an open single-use link: whoever opens it first joins with this
  /// role, providing their own email. Stamped at acceptance for the record.
  email          String?
  roleId         String
  teamId         String?
  regionId       String?
  tokenHash      String    @unique
  /// Copied onto the created user at acceptance. Never exposed in the UI.
  isOwner        Boolean   @default(false)
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?   @unique
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUser User?        @relation("InviteAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

// ─────────────────────────────────────────────────────────────
// Messaging automation (P1)
// ─────────────────────────────────────────────────────────────

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
  FAILED
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

/// An automated follow-up sequence: ordered, delayed template sends. A client
/// enrolls manually or when entering `triggerStageKey`; a reply stops steps
/// marked stopIfReplied, and consent is re-checked at every send.
model Sequence {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  isActive        Boolean   @default(true)
  triggerStageKey StageKey?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("SequenceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  steps        SequenceStep[]
  enrollments  SequenceEnrollment[]

  @@index([organizationId])
}

model SequenceStep {
  id            String               @id @default(cuid())
  sequenceId    String
  position      Int
  delayHours    Int                  @default(24)
  channel       CommunicationChannel
  templateKey   String
  stopIfReplied Boolean              @default(true)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, position])
}

model SequenceEnrollment {
  id            String           @id @default(cuid())
  sequenceId    String
  clientId      String
  status        EnrollmentStatus @default(ACTIVE)
  currentStep   Int              @default(0)
  nextRunAt     DateTime?
  stoppedReason String?
  enrolledById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, clientId])
  @@index([status, nextRunAt])
}

/// A one-off message queued for a future time, sent by the job runner through
/// the same consent-gated send path as a manual message.
model ScheduledMessage {
  id              String                 @id @default(cuid())
  organizationId  String
  clientId        String
  userId          String?
  channel         CommunicationChannel
  templateKey     String?
  subject         String?
  body            String?
  sendAt          DateTime
  status          ScheduledMessageStatus @default(PENDING)
  attempts        Int                    @default(0)
  error           String?
  communicationId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User?        @relation("ScheduledSender", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, sendAt])
  @@index([clientId])
}

/// A saved set of list filters, personal or shared with the whole team.
model SavedFilter {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  route          String   @default("/clients")
  params         Json     @default("{}")
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, route])
}

// ── Close-rate operations (Phase 1-3 operating model) ─────────────────

enum CoachingKind {
  ONE_ON_ONE
  CALL_QA
}

/// Pre-call AI Closer Brief. Reading material for the closer — never a
/// decision. Adoption is measured by viewedAt (Phase 1: "strong AI Brief
/// adoption across all closers").
model CloserBrief {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String
  requestedById  String
  provider       String  @default("mock")
  model          String?

  content     Json     @default("{}")
  generatedAt DateTime @default(now())

  viewedAt   DateTime?
  viewedById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("BriefRequester", fields: [requestedById], references: [id])
  viewedBy     User?        @relation("BriefViewer", fields: [viewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, clientId, generatedAt])
}

/// Weekly 1-on-1 coaching and call QA (Phase 1 operating rhythm).
model CoachingNote {
  id             String       @id @default(cuid())
  organizationId String
  subjectId      String
  authorId       String
  kind           CoachingKind
  clientId       String?
  callId         String?

  /// Call QA score 1-10; null for 1-on-1 coaching.
  score        Int?
  strengths    String?
  improvements String?
  body         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      User         @relation("CoachSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  author       User         @relation("CoachAuthor", fields: [authorId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([organizationId, subjectId, createdAt])
}

// ── Phase 2 operating model ──────────────────────────────────────────

enum NurtureKind {
  VIDEO
  EMAIL
  SMS
  CALL_PREP
}

/// Pre-call nurture touch (Phase 2: mandatory personalized video before the
/// closing call). confirmedAt = the client acknowledged/viewed it.
model NurtureTouch {
  id             String      @id @default(cuid())
  organizationId String
  clientId       String
  senderId       String
  kind           NurtureKind @default(VIDEO)
  url            String?
  note           String?
  sentAt         DateTime    @default(now())
  confirmedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sender       User         @relation("NurtureSender", fields: [senderId], references: [id])

  @@index([organizationId, clientId, sentAt])
}

enum HotLeadDecision {
  APPROVED
  REJECTED
}

/// Lead Qualifier sign-off on a hot lead (Phase 2: a qualifier reviews every
/// lead at/above the threshold before closers work it). Latest row wins.
model HotLeadReview {
  id                  String          @id @default(cuid())
  organizationId      String
  clientId            String
  reviewerId          String
  decision            HotLeadDecision
  reason              String?
  /// Probability at review time, so a later rescore can flag staleness.
  probabilityAtReview Int?
  createdAt           DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("HotLeadReviewer", fields: [reviewerId], references: [id])

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, decision])
}

// ── Inbound receiver — the classified stream of everything a connector sends ──

/// Every payload a connector delivers, classified for the /inbound workspace.
/// Layered on top of the intake pipeline: the lead upsert still runs, and this
/// captures WHAT the event was (a contact, a doc-status change, a stage move)
/// and which client it resolved to — so non-lead events (docs, statuses) are
/// legible instead of masquerading as duplicate leads.
model InboundEvent {
  id             String  @id @default(cuid())
  organizationId String
  sourceId       String
  connectorDefId String?
  submissionId   String?
  clientId       String?

  category   InboundCategory @default(OTHER)
  eventType  String
  externalId String
  summary    String

  rawPayload Json @default("{}")
  normalized Json @default("{}")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, category])
  @@index([clientId])
  @@index([sourceId])
}

/// A document and its latest status as reported by a connector (the CYS doc
/// lifecycle). Upserted by (org, externalId) so repeated status pushes update
/// the same row — the Inbound → Documents view reads from here.
model InboundDocument {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  sourceId       String?
  externalId     String
  name           String
  status         String
  note           String?
  url            String?
  receivedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalId])
  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

// ─────────────────────────────────────────────────────────────
// Enhancement wave — credential vault, ad sets, engine, deploys
// ─────────────────────────────────────────────────────────────

/// One encrypted credential field for a connector (AES-256-GCM, see
/// src/lib/crypto.ts). Only ciphertext + a display last4 ever touch the
/// database — plaintext exists in server memory for the duration of a call.
model ConnectorCredential {
  id             String  @id @default(cuid())
  organizationId String
  connectorId    String
  fieldKey       String
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     Int     @default(1)
  last4          String?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CredentialCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([connectorId, fieldKey])
  @@index([organizationId])
}

/// An ad set under a campaign (Meta Ads). Synced by the provider (or the
/// deterministic mock); daily stats attribute to it via CampaignDailyStat.adSetId.
model AdSet {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  externalId     String?
  name           String
  status         String   @default("active")
  dailyBudget    Decimal? @db.Decimal(12, 2)
  spend          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([campaignId])
}

/// One execution of a code-defined DAG (e.g. 'insight_scan'). Rows are
/// execution state only — step graphs are defined in code, never in the DB.
model EngineRun {
  id             String    @id @default(cuid())
  organizationId String
  kind           String
  /// PENDING | RUNNING | COMPLETED | FAILED
  status         String    @default("PENDING")
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  stats          Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        EngineStep[]
  insights     Insight[]

  @@index([organizationId, status])
}

/// One step of an EngineRun. Claimed atomically by the jobs tick; retried with
/// backoff via nextRunAt.
model EngineStep {
  id        String   @id @default(cuid())
  runId     String
  key       String
  dependsOn String[] @default([])
  /// PENDING | READY | RUNNING | COMPLETED | FAILED | SKIPPED
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  input     Json?
  output    Json?
  error     String?

  startedAt  DateTime?
  finishedAt DateTime?
  nextRunAt  DateTime?

  run EngineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([status, nextRunAt])
}

/// A reviewable AI insight. The model proposes; a named human accepts or
/// dismisses — and the measured outcome feeds the next run’s retrieval.
model Insight {
  id             String  @id @default(cuid())
  organizationId String
  runId          String?
  kind           String
  title          String
  body           String
  /// Retrieval citations: [{ source, ref, text }]
  evidence       Json    @default("[]")
  score          Float?
  /// PENDING_REVIEW | ACCEPTED | DISMISSED | EXPIRED
  status         String  @default("PENDING_REVIEW")

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  /// Measured after-effects, written once the accepted insight has had time to land.
  outcome      Json?
  createdAt    DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          EngineRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("InsightReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
}

/// One production deploy started from the deploy console.
model DeployRun {
  id             String    @id @default(cuid())
  organizationId String
  startedById    String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  /// RUNNING | SUCCEEDED | FAILED
  status         String    @default("RUNNING")
  commitHash     String?
  logPath        String?
  summary        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedBy    User         @relation("DeployStarter", fields: [startedById], references: [id])

  @@index([organizationId, startedAt])
}

// ─────────────────────────────────────────────────────────────
// Telephony — phone numbers, routing, and the prepaid wallet
// ─────────────────────────────────────────────────────────────

/// How a number's inbound calls are answered. Every mode still writes the call
/// to the client timeline; they differ only in who (if anyone) is rung first.
enum CallRouting {
  /// Ring one fixed number (the account's main line forwards to a cell/desk).
  FORWARD
  /// Ring the number's assigned users in order, each for RING_SECONDS.
  TEAM
  /// Never ring — greet and take a voicemail.
  VOICEMAIL_ONLY
}

enum PhoneNumberKind {
  LOCAL
  TOLL_FREE
}

enum PhoneNumberStatus {
  /// Purchase accepted by the provider but webhooks are not confirmed yet.
  PENDING
  ACTIVE
  /// Kept at the provider but parked — an unpaid wallet suspends, never releases.
  SUSPENDED
  /// Given back to the provider. The row stays for billing history.
  RELEASED
}

/// Who pays for a number: the account's own prepaid wallet, or the agency's
/// card on file (internal accounts only — see TELEPHONY_INTERNAL_SLUGS).
enum TelephonyBilling {
  WALLET
  AGENCY_CARD
}

/// One phone number owned by one account. `e164` is globally unique: a number
/// belongs to exactly one org at a time, which is what makes inbound routing
/// (To -> org) unambiguous.
model PhoneNumber {
  id             String            @id @default(cuid())
  organizationId String
  e164           String            @unique
  friendlyName   String
  kind           PhoneNumberKind   @default(LOCAL)
  status         PhoneNumberStatus @default(PENDING)

  /// Set on exactly one ACTIVE number per org (enforced in setPrimaryNumber):
  /// the account's main line, used as the default SMS From.
  isPrimary Boolean @default(false)

  areaCode String?
  region   String?
  locality String?

  /// 'mock' | 'twilio' — which adapter minted it, so a released number is
  /// always handed back to the provider that sold it.
  provider     String  @default("mock")
  providerSid  String?
  /// { sms: bool, mms: bool, voice: bool } as reported by the provider.
  capabilities Json    @default("{}")

  routing           CallRouting @default(VOICEMAIL_ONLY)
  /// FORWARD mode target, E.164.
  forwardTo         String?
  /// TEAM mode dial order: User ids, rung sequentially.
  teamUserIds       Json        @default("[]")
  voicemailGreeting String?
  recordCalls       Boolean     @default(false)
  /// Optional owner — a rep's direct line rather than an account line.
  assignedUserId    String?

  billingMode      TelephonyBilling @default(WALLET)
  monthlyCostCents Int              @default(0)
  setupCostCents   Int              @default(0)
  /// When the next monthly charge is due (null once RELEASED).
  nextRenewalAt    DateTime?
  releasedAt       DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser  User?         @relation("PhoneNumberAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("PhoneNumberCreator", fields: [createdById], references: [id], onDelete: SetNull)
  walletEntries WalletEntry[]

  @@index([organizationId, status])
  @@index([nextRenewalAt])
}

/// One prepaid balance per account. Internal accounts carry billingMode
/// AGENCY_CARD and never need a balance — their charges land on the agency
/// card and are recorded as ledger entries for visibility, not as a gate.
model TelephonyWallet {
  id                       String           @id @default(cuid())
  organizationId           String           @unique
  balanceCents             Int              @default(0)
  billingMode              TelephonyBilling @default(WALLET)
  /// Balance below which the account can no longer buy numbers, in cents.
  /// Purchases must leave at least this much behind.
  reserveCents             Int              @default(0)
  autoReloadEnabled        Boolean          @default(false)
  autoReloadThresholdCents Int              @default(1000)
  autoReloadAmountCents    Int              @default(2500)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      WalletEntry[]
}

enum WalletEntryKind {
  TOPUP
  NUMBER_SETUP
  NUMBER_MONTHLY
  USAGE_SMS
  USAGE_VOICE
  REFUND
  ADJUSTMENT
}

/// Append-only telephony ledger. `amountCents` is signed — positive credits the
/// account, negative debits it — and `balanceAfterCents` is the running balance
/// captured inside the same transaction as the wallet update, so the ledger can
/// always be replayed against the wallet.
model WalletEntry {
  id                String          @id @default(cuid())
  organizationId    String
  walletId          String
  kind              WalletEntryKind
  amountCents       Int
  balanceAfterCents Int
  description       String
  phoneNumberId     String?
  /// Provider/processor reference (Stripe session, Twilio SID) when there is one.
  externalRef       String?
  createdById       String?
  createdAt         DateTime        @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet       TelephonyWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber?    @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("WalletEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([walletId, createdAt])
}

/// Operator-only migration snapshots. No organization FK and no application API.
model WorkspaceMigrationArchive {
  runId     String
  tableName String
  recordId  String
  payload   Json
  createdAt DateTime @default(now())

  @@id([runId, tableName, recordId])
}
