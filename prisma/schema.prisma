// ─────────────────────────────────────────────────────────────
// Intake — forms, sheets and webhooks (Phase 2)
// ─────────────────────────────────────────────────────────────

enum InboundCategory {
  CONTACT
  DOCUMENT
  OPPORTUNITY
  NOTE
  APPOINTMENT
  OTHER
}

enum IntakeAuthMode {
  /// Sender signs each request body with HMAC-SHA256 (X-Intake-Signature).
  HMAC
  /// Sender presents a static shared token header (X-Connector-Token) — the
  /// only method GoHighLevel workflow webhooks can produce without a proxy.
  TOKEN
}

enum IntakeSourceKind {
  WEB_FORM
  GOOGLE_SHEET
  CSV_IMPORT
  META_LEAD_ADS
  GO_HIGH_LEVEL
  GENERIC_WEBHOOK
  ZAPIER
}

enum IntakeStatus {
  RECEIVED
  APPLIED
  DUPLICATE
  NEEDS_MAPPING
  FAILED
}

/// A configured origin for inbound leads. One row per form or spreadsheet, so an
/// organization can run many at once (unlike Connector, which is one per kind).
model IntakeSource {
  id                  String           @id @default(cuid())
  organizationId      String
  kind                IntakeSourceKind
  /// Catalog definition id from src/lib/connectors/catalog.ts (e.g. "gohighlevel").
  connectorDefId      String?
  name                String
  slug                String
  /// How the caller authenticates. HMAC (signed body) or TOKEN (static header).
  authMode            IntakeAuthMode   @default(HMAC)
  /// SHA-256 of the shared secret/token. Callers present the plaintext; we never store it.
  secretHash          String?
  /// { crmField: incomingKey } — configurable without a deploy.
  fieldMapping        Json             @default("{}")
  /// Which CRM fields identify an existing person. Order matters: first hit wins.
  dedupeKeys          String[]         @default(["email", "phone"])
  defaultOwnerId      String?
  /// Shared queue for newly-created leads. The application verifies this team
  /// belongs to organizationId before it is stamped on a Client.
  defaultTeamId       String?
  defaultLeadSourceId String?
  isEnabled           Boolean          @default(true)
  /// GOOGLE_SHEET only.
  sheetId             String?
  sheetTab            String?
  lastRowCursor       Int              @default(0)
  lastSyncAt          DateTime?
  lastSyncStatus      String?
  lastError           String?
  lastErrorAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultOwner User?              @relation("IntakeDefaultOwner", fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  defaultTeam  Team?              @relation("IntakeDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  submissions  IntakeSubmission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([defaultTeamId])
}

/// One inbound payload. (sourceId, externalId) is unique, which is what makes
/// webhook delivery idempotent: a replay updates this row instead of creating a lead.
model IntakeSubmission {
  id             String       @id @default(cuid())
  organizationId String
  sourceId       String
  externalId     String
  status         IntakeStatus @default(RECEIVED)
  rawPayload     Json         @default("{}")
  mappedPayload  Json         @default("{}")
  unmappedKeys   String[]     @default([])
  clientId       String?
  createdClient  Boolean      @default(false)
  matchedOn      String?
  error          String?
  attemptCount   Int          @default(1)
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       IntakeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  externalDocumentImports ExternalDocumentImport[]

  @@unique([sourceId, externalId])
  @@index([organizationId, status])
  @@index([clientId])
}

/// Durable provenance and retry ledger for files copied from SCS. The SCS
/// storage path and its temporary URLs never live in this table.
model ExternalDocumentImport {
  id                  String                       @id @default(cuid())
  organizationId      String
  intakeSubmissionId String
  clientId            String
  sourceDocumentId    String
  sourceLeadId        String?
  sourceFileName      String?
  sourceDocumentType  String?
  sourceMimeType      String?
  sourceSizeBytes     Int?
  status              ExternalDocumentImportStatus @default(PENDING)
  attempts            Int                          @default(0)
  lastError           String?
  sourceChecksum      String?
  importedChecksum    String?
  clientDocumentId    String?                      @unique
  importedAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intakeSubmission IntakeSubmission @relation(fields: [intakeSubmissionId], references: [id], onDelete: Cascade)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientDocument ClientDocument? @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)

  @@unique([intakeSubmissionId, sourceDocumentId])
  @@index([organizationId, status])
  @@index([clientId])
}

